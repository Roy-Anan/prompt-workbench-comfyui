# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Node
node_modules/
frontend/dist/

# Rust / Tauri (archived under legacy/src-tauri; not part of the Web runtime)
legacy/src-tauri/target/
legacy/src-tauri/gen/

# Local settings and logs
.env
.env.*
*.log
*.tmp

# Runtime PID file and structured identity record written by the launcher
.workbench.pid
.workbench-runtime.json

# User runtime data (database, knowledge, prompts, drafts, history, logs,
# backups, exports). Lives inside the Git repo but must never be committed.
/userdata/

# Other local user data
data/
workbench-data/

# Profile staging drops and runtime archive snapshots are local working
# copies; published rules under prompt_profiles/models and the manifest are
# committed, but transient staged drafts and archived revisions are not.
/prompt_profiles/staging/*
/prompt_profiles/archive/*
